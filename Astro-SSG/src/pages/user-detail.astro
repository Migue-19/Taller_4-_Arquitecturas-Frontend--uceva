---
import Badge from "@components/shared/Badge.astro";
import { USER_DETAIL } from "@data/UserDetail";
import type { BadgeType } from "@interfaces/Badge";
import type { UserDetail } from "@interfaces/UserDetail";
import type { UserEngineering } from "@interfaces/Users";
import MainLayout from "@layouts/MainLayout.astro";

const user: UserDetail = USER_DETAIL;

const engineeringMap: Record<UserEngineering, BadgeType> = {
  'Sistemas': 'success',
  'Electronica': 'primary',
  'Biomedica': 'warning',
  'Industrial': 'danger',
  'Ambiental': 'secondary',
};
---
<MainLayout>
  <div class="card shadow-sm border mx-auto" style="max-width: 540px;">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
      <span class="text-muted fw-bold">ID #{user.id}</span>
      <Badge
        text={user.engineering}
        type={engineeringMap[user.engineering]}
      />
    </div>
    <div class="card-body">
      <h4 class="card-title text-primary mb-3">{user.name} {user.lastName}</h4>
      <div class="list-group list-group-flush text-start">
        <div class="list-group-item px-0 d-flex justify-content-between">
          <strong class="text-secondary">Edad:</strong>
          <span>{user.age} años</span>
        </div>
        <div class="list-group-item px-0 d-flex justify-content-between">
          <strong class="text-secondary">Correo Electrónico:</strong>
          <span class="text-break">{user.email}</span>
        </div>
        <div class="list-group-item px-0 d-flex justify-content-between">
          <strong class="text-secondary">Carrera:</strong>
          <span>{user.engineering}</span>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
